# Server-only Web Service key. Never expose this in the browser bundle.
AMAP_WEB_SERVICE_KEY=
# Comma-separated deploy origins, for example https://trip.example.com
CORS_ORIGINS=http://localhost:5173
# Optional Redis URL. Without it, a bounded in-memory TTL cache is used.
REDIS_URL=
REQUEST_TIMEOUT_SECONDS=8
PLANNING_CACHE_TTL_SECONDS=900
