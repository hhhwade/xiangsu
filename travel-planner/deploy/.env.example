# Browser-side key: configure JS API 2.0 + your deployment domain allowlist in AMap.
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# Server-only key: enable Place Search, Geocoding, and Distance Matrix in AMap.
AMAP_WEB_SERVICE_KEY=

# The externally served frontend origin(s), comma separated.
CORS_ORIGINS=https://trip.example.com
WEB_PORT=8080
# Optional: use an external managed Redis in production.
REDIS_URL=redis://redis:6379/0
