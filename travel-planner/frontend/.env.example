# Browser key; restrict it to your production domain in AMap Console.
VITE_AMAP_JS_KEY=
# Required by newer AMap JS API key configurations.
VITE_AMAP_SECURITY_JS_CODE=
# Optional when the web app and API are deployed to different origins.
# Leave blank in production: nginx will proxy same-origin /api to FastAPI.
VITE_API_BASE_URL=
# Set true only to review the bundled POI / CSS map demo without an API process.
VITE_DEMO_MODE=true
# Vite server-side proxy target (never exposed to the browser).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
