{
  "name": "xiaolu-travel-planner-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "build:apk": "vue-tsc -b && vite build --mode apk",
    "mobile:sync": "npm run build:apk && npx cap sync android",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^5.7.8",
    "@snewbie/capacitor-amap": "^0.0.10",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vue-tsc": "^2.2.0"
  }
}
